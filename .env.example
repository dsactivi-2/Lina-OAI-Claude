LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=tbl7WHRtBkRX7tGxt
# Nur lokal: Test-Kandidat, wenn ein Job ohne Dispatch-Metadaten startet
LINA_TEST_RECORD_ID=
# Optional: Stimme und Backend-Modell für GPT-Live
LINA_VOICE=marin
LINA_BACKEND_MODEL=gpt-5.6-luna
# Prompt-Version: v2 (eingefroren, Standard) oder v3 (Lina 3, siehe docs/PLAN-lina-3.md).
# Leer: Cloud-Deployment „staging“ nimmt v3, production v2 (kein Secret nötig, Secrets gelten für alle Deployments)
LINA_PROMPT=v2
# Backend hinter GPT-Live: Standard low/low, leer = Modell-Standard; MAX_TOKENS nur opt-in
LINA_BACKEND_REASONING=low
LINA_BACKEND_VERBOSITY=low
LINA_BACKEND_MAX_TOKENS=
# Langfuse (optional, Tracing): https://cloud.langfuse.com = EU
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 1 = auch Gesprächsinhalte (Personendaten) an Langfuse, 0 = nur Metadaten
LANGFUSE_INHALTE=0
# Langfuse-Environment lokal (in der Cloud automatisch production/staging)
LINA_ENV=lokal
